# SDL2.ffi.example — template for binding SDL2 to Oberon
#
# To use: copy to SDL2.ffi somewhere on OBC_MOD_PATH, then write a
# SDL2.mod stub with matching procedure signatures.
#
# Format:
#   HEADER <system/header.h>  or  HEADER "local/header.h"
#   LINK   libname             (becomes -llibname on the gcc command)
#   MAP    OberonName CName    (emits  #define SDL2_OberonName CName)

HEADER <SDL2/SDL.h>
LINK   SDL2

# Initialisation
MAP Init          SDL_Init
MAP Quit          SDL_Quit
MAP InitSubSystem SDL_InitSubSystem

# Window management
MAP CreateWindow       SDL_CreateWindow
MAP DestroyWindow      SDL_DestroyWindow
MAP SetWindowTitle     SDL_SetWindowTitle

# Renderer
MAP CreateRenderer     SDL_CreateRenderer
MAP DestroyRenderer    SDL_DestroyRenderer
MAP RenderClear        SDL_RenderClear
MAP RenderPresent      SDL_RenderPresent
MAP SetRenderDrawColor SDL_SetRenderDrawColor
MAP RenderDrawRect     SDL_RenderDrawRect
MAP RenderFillRect     SDL_RenderFillRect

# Events
MAP PollEvent          SDL_PollEvent
MAP WaitEvent          SDL_WaitEvent

# Timing
MAP Delay              SDL_Delay
MAP GetTicks           SDL_GetTicks
