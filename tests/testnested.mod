MODULE testnested;
IMPORT Out;

PROCEDURE TestMany;
VAR x: INTEGER;

  PROCEDURE P01(): INTEGER; BEGIN RETURN x + 1 END P01;
  PROCEDURE P02(): INTEGER; BEGIN RETURN x + 2 END P02;
  PROCEDURE P03(): INTEGER; BEGIN RETURN x + 3 END P03;
  PROCEDURE P04(): INTEGER; BEGIN RETURN x + 4 END P04;
  PROCEDURE P05(): INTEGER; BEGIN RETURN x + 5 END P05;
  PROCEDURE P06(): INTEGER; BEGIN RETURN x + 6 END P06;
  PROCEDURE P07(): INTEGER; BEGIN RETURN x + 7 END P07;
  PROCEDURE P08(): INTEGER; BEGIN RETURN x + 8 END P08;
  PROCEDURE P09(): INTEGER; BEGIN RETURN x + 9 END P09;
  PROCEDURE P10(): INTEGER; BEGIN RETURN x + 10 END P10;
  PROCEDURE P11(): INTEGER; BEGIN RETURN x + 11 END P11;
  PROCEDURE P12(): INTEGER; BEGIN RETURN x + 12 END P12;
  PROCEDURE P13(): INTEGER; BEGIN RETURN x + 13 END P13;
  PROCEDURE P14(): INTEGER; BEGIN RETURN x + 14 END P14;
  PROCEDURE P15(): INTEGER; BEGIN RETURN x + 15 END P15;
  PROCEDURE P16(): INTEGER; BEGIN RETURN x + 16 END P16;
  PROCEDURE P17(): INTEGER; BEGIN RETURN x + 17 END P17;
  PROCEDURE P18(): INTEGER; BEGIN RETURN x + 18 END P18;
  PROCEDURE P19(): INTEGER; BEGIN RETURN x + 19 END P19;
  PROCEDURE P20(): INTEGER; BEGIN RETURN x + 20 END P20;
  PROCEDURE P21(): INTEGER; BEGIN RETURN x + 21 END P21;
  PROCEDURE P22(): INTEGER; BEGIN RETURN x + 22 END P22;
  PROCEDURE P23(): INTEGER; BEGIN RETURN x + 23 END P23;
  PROCEDURE P24(): INTEGER; BEGIN RETURN x + 24 END P24;
  PROCEDURE P25(): INTEGER; BEGIN RETURN x + 25 END P25;
  PROCEDURE P26(): INTEGER; BEGIN RETURN x + 26 END P26;
  PROCEDURE P27(): INTEGER; BEGIN RETURN x + 27 END P27;
  PROCEDURE P28(): INTEGER; BEGIN RETURN x + 28 END P28;
  PROCEDURE P29(): INTEGER; BEGIN RETURN x + 29 END P29;
  PROCEDURE P30(): INTEGER; BEGIN RETURN x + 30 END P30;
  PROCEDURE P31(): INTEGER; BEGIN RETURN x + 31 END P31;
  PROCEDURE P32(): INTEGER; BEGIN RETURN x + 32 END P32;
  PROCEDURE P33(): INTEGER; BEGIN RETURN x + 33 END P33;

BEGIN
  x := 0;
  Out.Int(P01(), 0); Out.Char(' ');
  Out.Int(P10(), 0); Out.Char(' ');
  Out.Int(P32(), 0); Out.Char(' ');
  Out.Int(P33(), 0); Out.Ln
END TestMany;

BEGIN
  TestMany
END testnested.
